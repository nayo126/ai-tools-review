---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const cats = Array.from(new Set(posts.map((p) => p.data.category)));
  const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9一-龠ぁ-んァ-ヶー]+/g, "-").replace(/^-|-$/g, "");
  return cats.map((c) => ({
    params: { category: slugify(c) || "all" },
    props: { name: c, posts: posts.filter((p) => p.data.category === c) },
  }));
}

const { name, posts } = Astro.props;
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={`${name} の記事一覧`} description={`${name} カテゴリの最新記事をまとめました。`}>
  <h1>{name} の記事一覧</h1>
  <ul class="post-list">
    {sorted.map((p) => (
      <li>
        <time>{p.data.pubDate.toISOString().slice(0, 10)}</time>
        <h2><a href={`${import.meta.env.BASE_URL}blog/${p.id}/`}>{p.data.title}</a></h2>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
