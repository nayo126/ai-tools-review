---
interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  category?: string;
  noindex?: boolean;
}
const { title, description = "ChatGPT・Claude・Gemini・Midjourney等のAIツールを高校生が徹底比較レビュー。料金・機能・使い方・選び方を一覧で。", pubDate, category, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.pages.dev");
const ogTitle = `${title} | AIツール比較レビュー`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
    <link rel="alternate" type="application/rss+xml" title="AI副業ラボ" href={import.meta.env.BASE_URL + "rss.xml"} />
    <style is:global>
      :root {
        --bg: #fafaf7;
        --fg: #1c1c1c;
        --muted: #5b5b5b;
        --accent: #1a73e8;
        --border: #e7e3da;
        --code-bg: #f1efea;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
        background: var(--bg); color: var(--fg);
        line-height: 1.85; font-size: 16px;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header.site, footer.site {
        max-width: 760px; margin: 0 auto; padding: 24px 20px;
      }
      header.site h1 { margin: 0; font-size: 22px; letter-spacing: -0.02em; }
      header.site nav { margin-top: 8px; font-size: 14px; }
      header.site nav a { margin-right: 16px; color: var(--muted); }
      main { max-width: 760px; margin: 0 auto; padding: 16px 20px 60px; }
      article h1 { font-size: 30px; line-height: 1.35; margin: 16px 0 8px; }
      article .meta { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
      article h2 { margin-top: 40px; padding-bottom: 6px; border-bottom: 2px solid var(--border); font-size: 22px; }
      article h3 { margin-top: 28px; font-size: 18px; }
      article p { margin: 16px 0; }
      article ul, article ol { padding-left: 1.5em; }
      article li { margin: 6px 0; }
      article code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.92em; }
      article pre { background: #101218; color: #e6edf3; padding: 16px; border-radius: 6px; overflow-x: auto; }
      article pre code { background: transparent; color: inherit; padding: 0; }
      article blockquote { border-left: 4px solid var(--accent); margin: 20px 0; padding: 4px 16px; color: #444; background: #fff; }
      .affiliate-card {
        border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin: 24px 0;
        background: #fff;
      }
      .affiliate-card .label { font-size: 12px; color: var(--muted); }
      .post-list { list-style: none; padding: 0; }
      .post-list li { padding: 16px 0; border-bottom: 1px solid var(--border); }
      .post-list time { color: var(--muted); font-size: 13px; }
      .post-list h2 { font-size: 18px; margin: 6px 0 4px; }
      .post-list p { margin: 0; color: var(--muted); font-size: 14px; }
      .tag { display: inline-block; background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; font-size: 12px; margin-right: 6px; color: var(--muted); }
      footer.site { color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); margin-top: 60px; }
    </style>
  </head>
  <body>
    <header class="site">
      <h1><a href={import.meta.env.BASE_URL} style="color: inherit;">AIツール比較レビュー</a></h1>
      <p style="margin: 4px 0 0; color: var(--muted); font-size: 13px;">ChatGPT・Claude・Gemini他、最新AIツールを高校生視点で徹底レビュー。</p>
      <nav>
        <a href={import.meta.env.BASE_URL}>トップ</a>
        <a href={import.meta.env.BASE_URL + "about/"}>運営者</a>
        <a href={import.meta.env.BASE_URL + "privacy/"}>プライバシー</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>© AIツール比較レビュー — 当サイトはアフィリエイト広告を含む場合があります（もしも・楽天・Amazonアソシエイト等）。</p>
      <p><a href={import.meta.env.BASE_URL + "privacy/"}>プライバシーポリシー</a> ・ <a href={import.meta.env.BASE_URL + "contact/"}>お問い合わせ</a></p>
    </footer>
  </body>
</html>
